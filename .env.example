# Base de datos PostgreSQL (contenedor en la red zettastock-net)
DATABASE_URL=postgresql://postgres:<password>@<nombre-contenedor-db>:5432/<database>

# Entorno y servidor
NODE_ENV=production
PORT=3000

# Orígenes permitidos para CORS (separados por comas)
CORS_ORIGINS=https://app.zettastock.com,https://zettastock.com,http://localhost:5173

# Ruta de logs dentro del contenedor (volumen api-logs)
LOG_FILE=/app/logs/api.log

# Correo (SMTP)
MAIL_HOST=smtp.gmail.com
MAIL_USER=cuenta@gmail.com
MAIL_PASSWORD=contraseña-aplicacion
MAIL_FROM='No Reply noreply@example.com'

# Usuario admin (creado por el seed)
ADMIN_EMAIL=admin@store.local
ADMIN_PASSWORD=cambiar-en-produccion

# Cloudflare R2 (imágenes)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=store
R2_PUBLIC_URL=https://pub-XXXXXXXXXXXXXXXX.r2.dev
# Secreto para firmar los JWT (generar con: openssl rand -hex 32)
JWT_SECRET=

# Pasarela de pagos (Fase 5.1)
# Stripe (cobros en USD con tarjeta). Webhook: POST /webhooks/payments/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Pabilo (pago móvil/transferencia en Venezuela; link creado en USD)
# API key: panel Pabilo → Integraciones → API keys
PABILO_API_KEY=
# Secreto del webhook: GET https://api.pabilo.app/me/webhook-secret (header appKey)
PABILO_WEBHOOK_SECRET=
# ID de la cuenta bancaria que recibe los fondos (GET /me/usersbank)
PABILO_USER_BANK_ID=
# URL pública del frontend (retorno del checkout) y de esta API (webhooks)
APP_BASE_URL=https://zettastock.com
PUBLIC_API_URL=https://dev-api.zettastock.com
