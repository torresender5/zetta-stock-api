model Supplier {
  id        Int            @id @default(autoincrement())
  companyId Int?
  company   Company?       @relation(fields: [companyId], references: [id])
  name      String
  document  String
  email     String
  phone     String
  address   String
  createdAt DateTime       @default(now())
  purchases Purchase[]

  @@unique([companyId, document])
}
