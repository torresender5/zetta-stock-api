model Product {
  id            Int            @id @default(autoincrement())
  companyId     Int?
  company       Company?       @relation(fields: [companyId], references: [id])
  name          String
  description   String?
  code          String
  purchasePrice Float
  salePrice     Float
  stock         Int
  sku           String
  type          String
  category      String
  image         String?
  sizes         Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  saleItems     SaleItem[]
  purchaseItems PurchaseItem[]
  apartadoItems ApartadoItem[]
}

model ProductType {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  name2       String
  description String?
  code        String
  createdAt   DateTime @default(now())
}