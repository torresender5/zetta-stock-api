model User {
  id        Int      @id @default(autoincrement())
  user      String
  email     String   @unique
  password  String
  role      String   @default("admin") // admin | vendedor | inventario
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  cashRegisters CashRegister[]
  // Consentimiento legal (Ley OPDP 1733) — Fase 1 del PLAN_LEGAL.md
  acceptedTerms Boolean     @default(false)
  termsVersion  String?
  acceptedAt    DateTime?
  consentLogs   ConsentLog[]
  dataSubjectRequests DataSubjectRequest[]
}

// Prueba de aceptación de cada documento legal (Términos, Privacidad, etc.).
model ConsentLog {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String   // terms | privacy | subscription | marketing
  version    String
  acceptedAt DateTime @default(now())
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([userId])
}

// Solicitud de derechos ARCO del titular de datos (Ley OPDP 1733) — Fase 3 del PLAN_LEGAL.md.
model DataSubjectRequest {
  id         Int       @id @default(autoincrement())
  userId     Int
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type       String // acceso | rectificacion | supresion | revocacion
  motivo     String
  status     String    @default("pendiente") // pendiente | completada | rechazada
  detail     String?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())
  dueAt      DateTime // SLA: 15 días hábiles (Política de Privacidad, sección 8)
  resolvedAt DateTime?

  @@index([userId])
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  kind        String   @default("PERSONA") // PERSONA | EMPRESA
  document    String?
  phoneNumber String?
  address     String?
  description String?
  active      Boolean  @default(true)
  // Configuración de la empresa (Fase 5.5)
  currency      String   @default("USD") // USD | VES — moneda base
  taxRate       Int      @default(19) // % de IVA aplicado en ventas
  invoicePrefix String   @default("FAC") // Prefijo de numeración de facturas
  salePrefix    String   @default("VEN") // Prefijo de numeración de ventas
  logoUrl       String? // Logo de la empresa (Cloudflare R2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  products    Product[]
  categories  Category[]
  clients     Client[]
  suppliers   Supplier[]
  purchases   Purchase[]
  sales       Sale[]
  invoices    Invoice[]
  cashRegisters  CashRegister[]
  cashMovements  CashMovement[]
  apartados      Apartado[]
  apartadoPayments ApartadoPayment[]
  subscription   Subscription?
  paymentOrders  PaymentOrder[]
  notifications  Notification[]
  tickets        Ticket[]
}

model Category {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  description String?
  code        String
  createdAt   DateTime @default(now())
  products    Product[]
}
