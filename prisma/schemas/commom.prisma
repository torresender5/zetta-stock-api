model User {
  id        Int      @id @default(autoincrement())
  user      String
  email     String   @unique
  password  String
  role      String   @default("admin") // admin | vendedor | inventario
  createdAt DateTime @default(now())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  person    Person[]
  cashRegisters CashRegister[]
}

model Posts {
  id          Int      @id @default(autoincrement())
  description String
  title       String
  createdAt   DateTime @default(now())
}

model Person {
  id             Int      @id @default(autoincrement())
  name           String
  secondName     String
  lastName       String
  secondLastName String
  phoneNumber    String
  address        String
  userId         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  kind        String   @default("PERSONA") // PERSONA | EMPRESA
  document    String?
  phoneNumber String?
  address     String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
  products    Product[]
  productTypes ProductType[]
  categories  Category[]
  clients     Client[]
  suppliers   Supplier[]
  purchases   Purchase[]
  sales       Sale[]
  invoices    Invoice[]
  cashRegisters  CashRegister[]
  cashMovements  CashMovement[]
  apartados      Apartado[]
  apartadoPayments ApartadoPayment[]
}

model Category {
  id          Int      @id @default(autoincrement())
  companyId   Int?
  company     Company? @relation(fields: [companyId], references: [id])
  name        String
  description String?
  code        String
  createdAt   DateTime @default(now())
}
