model User {
  id        Int      @id @default(autoincrement())
  user      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  person    Person[]
}

model Posts {
  id          Int      @id @default(autoincrement())
  description String
  title       String
  createdAt   DateTime @default(now())
}

model Person {
  id             Int      @id @default(autoincrement())
  name           String
  secondName     String
  lastName       String
  secondLastName String
  phoneNumber    String
  address        String
  userId         Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id])
}

model Company {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  phoneNumber String
  address     String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @default(now())
}

model Category {
  id          Int      @id @default(autoincrement())
  name        String
  description String?
  code        String
  createdAt   DateTime @default(now())
}
