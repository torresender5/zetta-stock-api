model Client {
  id        Int      @id @default(autoincrement())
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  name      String
  email     String
  phone     String
  address   String
  document  String
  createdAt DateTime @default(now())
  sales     Sale[]
  invoices  Invoice[]
  apartados Apartado[]

  @@unique([companyId, email])
  @@unique([companyId, document])
}
